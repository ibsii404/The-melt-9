rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isCustomer() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer';
    }
    
    function isKitchen() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kitchen';
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isKitchen() || isAdmin());
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Users can only update their own data, not create/delete
      allow create: if false; // Users created through Auth, not Firestore directly
      allow delete: if isAdmin();
      
      // Subcollection for addresses (if we store separately)
      match /addresses/{addressId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }
    
    // Menu Collection - Public read, kitchen write
    match /menu/{itemId} {
      // Anyone can read menu (even unauthenticated)
      allow read: if true;
      
      // Only kitchen staff and admin can write
      allow write: if isKitchen() || isAdmin();
      
      // Validate menu item data on write
      allow create: if (isKitchen() || isAdmin()) && 
        request.resource.data.keys().hasAll(['name', 'category', 'available']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      
      allow update: if (isKitchen() || isAdmin()) &&
        (request.resource.data.available == true || request.resource.data.available == false);
    }
    
    // Orders Collection
    match /orders/{orderId} {
      // Customers can create/read their own orders.
      // Kitchen/admin can read and update status fields.

      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total > 0;

      allow read: if isAuthenticated() && (
        isKitchen() ||
        isAdmin() ||
        resource.data.customerId == request.auth.uid
      );

      allow update: if isAuthenticated() && (isKitchen() || isAdmin()) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'statusHistory',
          'estimatedDeliveryTime',
          'actualDeliveryTime',
          'updatedAt'
        ])
      );

      // No hard delete for orders.
      allow delete: if false;
    }
    
    // Deals Collection
    match /deals/{dealId} {
      // Anyone can read deals
      allow read: if true;
      
      // Only kitchen and admin can write
      allow write: if isKitchen() || isAdmin();
    }
    
    // Blog Collection
    match /blog/{postId} {
      // Anyone can read published posts
      allow read: if resource.data.status == 'published' || isKitchen() || isAdmin();
      
      // Only kitchen and admin can write
      allow write: if isKitchen() || isAdmin();
    }
    
    // Kitchen Staff - Special collection for kitchen users
    match /kitchen/{userId} {
      allow read: if isAuthenticated() && (isKitchen() || isAdmin());
      allow write: if isAdmin();
    }
    
    // System settings (hours, delivery zones, etc.)
    match /settings/{settingId} {
      allow read: if true; // Anyone can read settings
      allow write: if isAdmin(); // Only admin can change settings
    }

    // App counters (order sequence, etc.)
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }
  }
}
